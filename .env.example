# Copy to apps/web/.env.local for local dev. Every env var used anywhere in the
# monorepo MUST be listed here with a comment (see CLAUDE.md conventions).

# --- Supabase (Phase 1: unified project; consumed by @dreamplay/db clients) ---
# Project URL, e.g. https://<project-ref>.supabase.co (dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key — safe for the browser, access gated by RLS (deny-by-default)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SECRET, bypasses RLS; server-side only (createAdminClient)
SUPABASE_SERVICE_ROLE_KEY=
