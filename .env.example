# Copy to apps/web/.env.local for local dev. Every env var used anywhere in the
# monorepo MUST be listed here with a comment (see CLAUDE.md conventions).

# --- Supabase (Phase 1: unified project; consumed by @dreamplay/db clients) ---
# Project URL, e.g. https://<project-ref>.supabase.co (dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key — safe for the browser, access gated by RLS (deny-by-default)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SECRET, bypasses RLS; server-side only (createAdminClient)
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Phase 2: transactional emails + tracking) ---
# Resend API key — contact-form notifications + subscribe welcome emails (server only)
RESEND_API_KEY=
# Email tracking endpoint used by EmailTracker (defaults to https://email.dreamplaypianos.com/api/track)
NEXT_PUBLIC_EMAIL_TRACK_URL=
# External subscribe webhook used by subscribeToNewsletter (defaults to https://email.dreamplaypianos.com/api/webhooks/subscribe)
EMAIL_SUBSCRIBE_WEBHOOK_URL=

# --- Shopify (Phase 2: commerce + buyer portal + webhooks) ---
# Store domain, e.g. your-store.myshopify.com (server-side Storefront/Admin calls)
SHOPIFY_STORE_DOMAIN=
# Store domain exposed to the browser (cart permalinks / Storefront API from client)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
# Storefront API access token (server-side cartCreate)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Storefront API access token exposed to the browser (public by design)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Storefront API version, e.g. 2026-01
SHOPIFY_STOREFRONT_API_VERSION=
# Admin API version, e.g. 2026-01
SHOPIFY_API_VERSION=
# Admin API client-credentials app: client ID (order lookups for /my-reservation)
SHOPIFY_ADMIN_CLIENT_ID=
# Admin API client-credentials app: client secret — SECRET
SHOPIFY_ADMIN_CLIENT_SECRET=
# Webhook HMAC signing secret for api/webhooks/shopify/orders — SECRET
SHOPIFY_WEBHOOK_SECRET=
# Shopify app client ID used by ops scripts (scripts/shopify/*)
SHOPIFY_CLIENT_ID=
# Shopify app client secret used by ops scripts — SECRET
SHOPIFY_CLIENT_SECRET=

# --- Analytics (Phase 3: /api/track ingest) ---
# Comma-separated EXTRA origins allowed to POST /api/track cross-origin
# (e.g. https://data.dreamplaypianos.com,https://email.dreamplaypianos.com).
# Same-origin requests are always allowed; leave empty for same-origin only.
ANALYTICS_ALLOWED_ORIGINS=

# --- AI (Phase 2: chatbot at api/chat + api/chatbot-models) ---
# Anthropic API key (chatbot "anthropic:*" models + model list)
ANTHROPIC_API_KEY=
# Google Generative AI API key (chatbot "google:*" models + model list)
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Email pipeline (Phase 5: packages/email + Inngest + agent API) ---
# Inngest event key — lets the app SEND events (agent API dispatches sends)
INNGEST_EVENT_KEY=
# Inngest signing key — verifies Inngest's calls to /api/inngest
INNGEST_SIGNING_KEY=
# Bearer token for the agent API at /api/agent/{workspace}/... — SECRET
AGENT_API_KEY=
# Svix signing secret for /api/webhooks/resend (Resend dashboard > Webhooks) — SECRET.
# If unset the webhook returns 500 (it NEVER processes unverified payloads).
RESEND_WEBHOOK_SECRET=
# Default From for campaign sends when neither campaign nor caller sets one,
# e.g. "DreamPlay <hello@email.dreamplaypianos.com>"
RESEND_FROM_EMAIL=
# Per-invocation send throttle in requests/second (Resend account limit is 5)
RESEND_SEND_RATE_PER_SEC=5
# Base URL for open-pixel/click/unsubscribe links when the From domain has no
# dedicated tracking host. Default: NEXT_PUBLIC_APP_URL (same app).
TRACKING_BASE_URL=
# HMAC secret signing unsubscribe links (s/c params) so subscriber ids can't
# be enumerated to mass-unsubscribe an audience — SECRET, any long random string
EMAIL_UNSUBSCRIBE_SECRET=
# Public URL of this deployment (used for tracking-link fallback + send-wave CLI)
NEXT_PUBLIC_APP_URL=
# Agent API host used by the send-wave CLI (defaults to NEXT_PUBLIC_APP_URL)
DREAMPLAY_EMAIL_BASE_URL=

# --- Zoom (founder call invites) ---
# Server-to-Server OAuth app credentials, used by scripts/email/send-call-invites.mjs
# to create one scheduled meeting per booked call so every buyer gets their own
# join URL. Zoom dashboard -> Develop -> Build App -> Server-to-Server OAuth.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
# SECRET
ZOOM_CLIENT_SECRET=
