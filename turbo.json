{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ],
      "env": [
        "NEXT_PUBLIC_*",
        "SUPABASE_*",
        "SHOPIFY_*",
        "RESEND_*",
        "INNGEST_*",
        "AGENT_API_KEY",
        "INTERNAL_API_SECRET",
        "ANTHROPIC_API_KEY",
        "GOOGLE_GENERATIVE_AI_API_KEY",
        "OPENAI_API_KEY",
        "GEMINI_API_KEY",
        "R2_*",
        "TRACKING_BASE_URL",
        "EMAIL_*",
        "DREAMPLAY_EMAIL_BASE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {}
  }
}
